{
  "enabled": true,
  "channels": {
    "system": {
      "enabled": true,
      "sound": true,
      "soundName": "Glass",
      "sounds": {
        "conversationFailed": "Basso"
      }
    },
    "webhook": {
      "enabled": false,
      "url": "https://your-webhook-endpoint.com/notify",
      "method": "POST",
      "timeout": 5000,
      "headers": {
        "Authorization": "Bearer your-secret-token"
      }
    },
    "wecom": {
      "enabled": false,
      "webhookUrl": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_WEBHOOK_KEY",
      "msgType": "markdown",
      "mentions": ["@all"]
    },
    "wechat": {
      "enabled": false,
      "toUserIds": [],
      "interactive": true
    },
    "telegram": {
      "enabled": false,
      "botToken": "YOUR_BOT_TOKEN",
      "chatId": "YOUR_CHAT_ID",
      "parseMode": "HTML",
      "disableNotification": false,
      "interactive": true
    }
  },
  "events": {
    "conversationCompleted": true,
    "conversationPaused": true,
    "conversationFailed": true,
    "authorizationRequired": true,
    "confirmationRequired": true
  },
  "titlePrefix": "[DSH]",
  "mainAgentOnly": true
}
