{
  "name": "dsh-notify-plugin",
  "description": "Notification plugin for DeepSeek Harness - supports system notifications, webhooks, WeCom bots, WeChat ClawBot and Telegram bots",
  "version": "1.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc",
    "build:client": "tsdown && node scripts/normalize-client-banner.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "prepack": "npm run build && node scripts/preflight.mjs"
  },
  "keywords": [
    "dsh",
    "plugin",
    "notification",
    "webhook",
    "wecom",
    "wechat",
    "clawbot",
    "deepseek-harness"
  ],
  "author": "btboys",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btboys/dsh-notify.git"
  },
  "bugs": {
    "url": "https://github.com/btboys/dsh-notify/issues"
  },
  "homepage": "https://github.com/btboys/dsh-notify#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.2",
    "axios": "^1.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.3.0"
  }
}
